# ============================================================
# デモ環境用の設定値サンプル
# `cp .env.example .env` してから利用してください。
#
# ここに書かれている資格情報はすべて「ローカルデモ専用」です。
# 実運用のシークレットは絶対にコミットしないでください。
# ============================================================

# --- デモ用データ DB(postgres:16 / compose profile: base) ---
DEMO_DB_HOST=postgres-demo
DEMO_DB_PORT=5432
# ホスト側に公開するポート(他プロセスと衝突する場合はここを変更)
DEMO_DB_HOST_PORT=15432
DEMO_DB_USER=demo
DEMO_DB_PASSWORD=demo_password
DEMO_DB_NAME=demo

# --- Marquez(compose profile: lineage / フェーズ2)---
# ホスト側に公開するポート。他プロセスと衝突する場合はここを変更
# (macOS では 5000 番が OS に予約されることがある。docs/guides/lineage.md 参照)
MARQUEZ_API_HOST_PORT=5000
MARQUEZ_ADMIN_HOST_PORT=5001
MARQUEZ_WEB_HOST_PORT=3000

# --- OpenMetadata(compose profile: catalog / フェーズ3)---
# ホスト側に公開するポート。他プロセスと衝突する場合はここを変更
# (UI/API は OM_SERVER_HOST_PORT、ヘルスチェック用管理ポートは OM_ADMIN_HOST_PORT)
OM_SERVER_HOST_PORT=8585
OM_ADMIN_HOST_PORT=8586

# --- datacontract-cli(compose profile: contract / フェーズ4)---
# コンテナが verification/ 等へ書き込む際の実行ユーザー。通常は変更不要。
# ホストの `id -u` / `id -g` が 1000 以外の場合のみ合わせて変更する。
DC_UID=1000
DC_GID=1000
