        "source": "Manual",
        "sqlQuery": "CREATE TABLE mart.daily_sales AS\nSELECT\n    order_date              AS sales_date,\n    count(DISTINCT order_id) AS order_count,\n    sum(amount)             AS total_amount\nFROM staging.stg_orders\nGROUP BY order_date\nORDER BY order_date;",
