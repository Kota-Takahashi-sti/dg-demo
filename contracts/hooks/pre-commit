#!/usr/bin/env bash
# データコントラクトの破壊的変更ゲート(pre-commit フック)
# GitHub Actions が使えない環境向けの代替(docs/guides/D-contract.md 参照)。
# ステージされた contracts/*.yaml を HEAD 版と比較し、破壊的変更があれば
# コミットをブロックする。導入方法: make install-contract-hook
set -euo pipefail

cd "$(git rev-parse --show-toplevel)"

# 変更(M)された契約ファイルのみ対象。新規追加は比較対象の HEAD 版がないため対象外。
files=$(git diff --cached --name-only --diff-filter=M -- 'contracts/*.yaml')
[ -z "$files" ] && exit 0

tmpdir=$(mktemp -d .contract-gate.XXXXXX)
trap 'rm -rf "$tmpdir"' EXIT

status=0
for f in $files; do
    old="$tmpdir/old_$(basename "$f")"
    new="$tmpdir/new_$(basename "$f")"
    git show "HEAD:$f" > "$old"
    git show ":$f" > "$new"   # ステージされた内容(作業ツリーではなく index の版)
    echo "[contract-gate] $f を HEAD 版と比較します"
    if ! docker compose --profile contract run --rm -T --entrypoint python datacontract \
            contracts/check_breaking.py "$old" "$new"; then
        status=1
    fi
done

if [ "$status" -ne 0 ]; then
    echo "[contract-gate] 破壊的変更を検知したため、コミットをブロックしました。" >&2
    echo "[contract-gate] 消費者と合意済みで進める場合のみ git commit --no-verify で回避できます。" >&2
fi
exit "$status"
